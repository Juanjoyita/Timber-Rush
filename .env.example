# Plantilla de configuración de Appwrite: copiar como ".env" y completar.
# Vite solo expone al navegador las variables que empiezan por VITE_.
# NUNCA pongas aquí una API Key de Appwrite: este archivo acaba en el frontend.
# Tras modificar ".env", reinicia "npm run dev".
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_PROGRESS_TABLE_ID=
